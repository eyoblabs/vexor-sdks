{
  "name": "@vexor-video/player",
  "version": "0.1.3",
  "description": "Official React and Vanilla JS video player for Vexor encrypted HLS streaming.",
  "author": "Vexor <support@vexor.et>",
  "license": "MIT",
  "homepage": "https://vexor-video.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/eyoblabs/-vexor-sdks.git",
    "directory": "packages/player"
  },
  "bugs": {
    "url": "https://github.com/eyoblabs/-vexor-sdks/issues"
  },
  "keywords": [
    "vexor",
    "video",
    "player",
    "hls",
    "streaming",
    "encrypted",
    "react-player",
    "drm",
    "watermark",
    "video-player"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css",
    "./dist/index.css"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/index.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vanilla": {
      "types": "./dist/vanilla.d.ts",
      "import": "./dist/vanilla.js",
      "require": "./dist/vanilla.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./index.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ./scripts/clean-dist.cjs && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "hls.js": "^1.5.20"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
